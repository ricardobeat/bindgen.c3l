 }
 
+// [bindgen] Skip a run of trailing __attribute__/__asm__ after a
+// declarator. Real headers put availability, deprecated, format,
+// nonnull and asm-renames here; none change the emitted binding.
+static Token *skip_trailing_attrs(Token *tok) {
+  for (;;) {
+    if (!equal(tok, "__attribute__") && !equal(tok, "__asm") &&
+        !equal(tok, "__asm__"))
+      return tok;
+    tok = tok->next;
+    if (!equal(tok, "("))
+      continue;
+    int depth = 0;
+    do {
+      if (equal(tok, "(")) depth++;
+      else if (equal(tok, ")")) depth--;
+      tok = tok->next;
+    } while (depth > 0);
+  }
+}
+
 static Token *function(Token *tok, Type *basety, VarAttr *attr) {
   Type *ty = declarator(&tok, tok, basety);
+  tok = skip_trailing_attrs(tok);
   if (!ty->name)
     error_tok(ty->name_pos, "function name omitted");
   char *name_str = get_ident(ty->name);
@@ -3270,6 +3320,7 @@ static Token *global_variable(Token *tok, Type *basety, VarAttr *attr) {
     first = false;
 
     Type *ty = declarator(&tok, tok, basety);
+    tok = skip_trailing_attrs(tok);
     if (!ty->name)
       error_tok(ty->name_pos, "variable name omitted");
 
diff --git a/preprocess.c b/preprocess.c
index 2bef487..f0a27ec 100644
--- a/preprocess.c
+++ b/preprocess.c
@@ -979,6 +979,15 @@ static Token *preprocess2(Token *tok) {
     if (equal(tok, "error"))
       error_tok(tok, "error");
 
+    // [bindgen] #warning: headers use it to complain about the compiler
+    // (Apple's sys/cdefs.h rejects anything that is not clang/gcc).
+    // Consume the rest of the line and carry on.
+    if (equal(tok, "warning")) {
+      while (tok && !tok->at_bol)
+        tok = tok->next;
+      continue;
+    }
+
     // `#`-only line is legal. It's called a null directive.
     if (tok->at_bol)
       continue;
