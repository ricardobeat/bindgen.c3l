-      error_tok(tok, "unknown attribute");
+      // [bindgen] Skip any other attribute, balancing nested parens.
+      // Real headers use dozens (availability, deprecated, format, ...)
+      // and none of them affect the binding we emit.
+      tok = tok->next;
+      if (equal(tok, "(")) {
+        int depth = 0;
+        do {
