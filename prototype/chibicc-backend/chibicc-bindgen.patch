+// [bindgen] Skip a run of trailing __attribute__/__asm__ after a
+// declarator. Real headers put availability, deprecated, format,
+// nonnull and asm-renames here; none change the emitted binding.
+static Token *skip_trailing_attrs(Token *tok) {
+  for (;;) {
+    if (!equal(tok, "__attribute__") && !equal(tok, "__asm") &&
+        !equal(tok, "__asm__"))
+      return tok;
+    tok = tok->next;
+    if (!equal(tok, "("))
+      continue;
+    int depth = 0;
+    do {
+      if (equal(tok, "(")) depth++;
+      else if (equal(tok, ")")) depth--;
+      tok = tok->next;
+    } while (depth > 0);
+  }
+}
